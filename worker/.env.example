# VaultID upload Worker — example env file.
# Set actual secrets via `wrangler secret put <name>` (NEVER commit them).

# ---- Cloudflare secrets (wrangler secret put) ----
PINATA_JWT=
ALCHEMY_API_KEY=

# ---- Wrangler vars (in wrangler.toml [vars] block; non-secret) ----
# Comma-separated list of allowed origins, or "*" for any.
FRONTEND_ORIGIN=https://your-frontend.example
VAULTID_ADDRESS=0x6252F44e1C92F3dD614B11Cc6e8699a8cCf26558
CLAWD_ADDRESS=0x9f86dB9fc6f7c9408e8Fda3Ff8ce4e78ac7a6b07
# 0 = look up clawdMintFee from the contract at request time. Otherwise, the
# Worker compares allowance against this fixed wei value (e.g. 1000000000000000000).
MIN_ALLOWANCE_WEI=0
ALCHEMY_BASE_PATH=base-mainnet
