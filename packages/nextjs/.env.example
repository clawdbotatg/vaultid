# VaultID frontend env vars
# Copy this file to .env.local for development. For static-export builds, prefix every
# var with NEXT_PUBLIC_ (Next.js inlines them at build time).

# Alchemy API key — required for Base RPC. Free key at https://dashboard.alchemy.com.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# WalletConnect Cloud project ID (optional — falls back to a shared dev project ID).
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Public origin used for absolute URLs in OG images and metadata. Example:
# https://vaultid.example.eth.limo or https://<cid>.ipfs.community.bgipfs.com
NEXT_PUBLIC_PRODUCTION_URL=

# Cloudflare Worker URL for the upload proxy. The Worker holds the Pinata JWT
# server-side and gates uploads on CLAWD allowance. Example:
# https://vaultid-upload.your-subdomain.workers.dev
NEXT_PUBLIC_WORKER_URL=

# OPTIONAL DEV-ONLY fallback for direct Pinata uploads when no Worker is provisioned.
# If set AND NEXT_PUBLIC_WORKER_URL is empty, the frontend will upload directly to
# Pinata using this JWT. This bundles the JWT into the static build — only use it
# for local testing or short-lived demos.
NEXT_PUBLIC_PINATA_JWT=
